@page "/cadcad"
@using System.Net.Http.Json

@using ControleAnaliseDesembolso.Componentes
@using ControleAnaliseDesembolso.Modelos
@using ControleAnaliseDesembolso.Service
@using Plataforma.UI.Shared.Model
@inject NavigationManager Nav
@inject NotificacaoServiceUI NotificacaoService
@inject SignalRServiceUI Hub
@inject ServicoUsuarioUI ServicoUsuario
@inject ControleAnaliseDesembolsoService Service
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@implements IDisposable
<PageTitle>Análise de Desembolsos — SIPUB</PageTitle>
<style>
    ﻿ /* ══════════════════════════════════════════════
       PÁGINA — wrapper geral
       ══════════════════════════════════════════════ */
    .mud-container{
        margin:0px;
    }
    .pagina {
        display: flex;
        flex-direction: column;
        min-height: calc(100vh - var(--topbar-h));
        background: #F4F7FB;
    }

    /* ══════════════════════════════════════════════
       SEÇÃO HEADER (fundo azul-acinzentado)
       ══════════════════════════════════════════════ */
    .pagina-header-secao {
        background: #F4F7FB;
        border-bottom: 1px solid #E4EBF0;
    }

    .pagina-header-container {
        max-width: 1200px;
        margin: 0; /* alinhado à esquerda (junto ao menu), mas limitado em telas grandes */
        padding: 32px;
    }

    /* Título 40px extrabold — "Análise de Desembolsos" */
    .pagina-titulo {
        font-size: 40px;
        font-weight: 800;
        line-height: 1.05;
        letter-spacing: -.02em;
        color: var(--ink-900);
    }

    .titulo-destaque {
        color: var(--brand-700);
    }

    /* ── Stats Consolidado card ── */
    .stats-consolidado {
        margin-top: 24px;
        overflow: hidden;
        border-radius: var(--radius-xl);
        border: 1px solid var(--ink-100);
        background: #fff;
        box-shadow: var(--shadow-card);
    }

    .stats-consolidado-header {
        background: #FAFBFC;
        border-bottom: 1px solid var(--ink-100);
        padding: 10px 20px;
    }

    .stats-consolidado-titulo {
        font-size: 12.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .16em;
        color: var(--ink-500);
    }

    .stats-consolidado-cells {
        display: flex;
    }

    .stats-cell {
        flex: 1;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 16px 20px;
        border-right: 1px solid var(--ink-100);
        transition: background .15s;
    }

        .stats-cell:last-child {
            border-right: none;
        }

        .stats-cell:hover {
            background: #FAFBFC;
        }

    .stats-cell-icon {
        width: 32px;
        height: 32px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .stats-cell-valor {
        font-size: 26px;
        font-weight: 800;
        line-height: 1;
        color: var(--ink-900);
        font-variant-numeric: tabular-nums;
    }

    .stats-cell-label {
        font-size: 10.5px;
        font-weight: 500;
        color: var(--ink-500);
        margin-top: 4px;
    }

    /* ══════════════════════════════════════════════
       BARRA DE FILTROS + TOOLBAR
       ══════════════════════════════════════════════ */
    .filtros-area {
        background: #F4F7FB;
    }

    .filtros-container {
        max-width: 1200px;
        margin: 0;
        padding: 12px 32px;
        display: flex;
        /* Uma linha em telas largas; ao apertar, a toolbar quebra para a linha
           de baixo (flex-wrap) e o margin-left:auto a mantém à direita. */
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
        border-bottom: 1px solid var(--ink-100);
    }

    /* Pill segmentado (alinhado à esquerda) */
    .filtro-pill {
        display: inline-flex;
        align-items: center;
        border-radius: var(--radius-full);
        padding: 4px;
        gap: 2px;
        background: #EEF2F4;
    }

    .filtro-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: var(--radius-full);
        padding: 6px 16px;
        font-size: 12px;
        font-weight: 700;
        font-family: inherit;
        color: var(--ink-500);
        background: transparent;
        border: none;
        cursor: pointer;
        transition: color .15s, background .15s, box-shadow .15s;
        white-space: nowrap;
    }

        .filtro-btn:hover {
            color: var(--ink-700);
        }

    .filtro-btn-ativo {
        background: #fff !important;
        color: var(--ink-900) !important;
        box-shadow: var(--shadow-card);
    }

    .filtro-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        flex-shrink: 0;
        display: inline-block;
        transition: opacity .15s;
    }

    .filtro-badge {
        border-radius: var(--radius-full);
        padding: 1px 6px;
        font-size: 10px;
        font-weight: 800;
        background: var(--ink-200);
        color: var(--ink-500);
        font-variant-numeric: tabular-nums;
    }

    .filtro-badge-ativo {
        background: var(--ink-100);
        color: var(--ink-700);
    }

    /* Grupo de consulta: pills + período + busca — tudo que estreita o que
       aparece na lista. Fica à esquerda, agrupado visualmente. */
    .grupo-consulta {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    /* Grupo de ações: cria/processa — separado do grupo de consulta por uma
       divisória fina, pra o olho distinguir "isso filtra" de "isso faz algo"
       sem precisar ler o texto de cada botão. Encostado à direita; quebra
       pra linha de baixo (mantendo-se à direita) quando não cabe. */
    .grupo-acoes {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-left: auto;
        padding-left: 14px;
        border-left: 1px solid var(--ink-100);
        flex-wrap: wrap;
    }

    /* Chip "Última Atualização" */
    .chip-atualizacao {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-radius: var(--radius-full);
        border: 1px solid var(--ink-200);
        background: #fff;
        padding: 6px 14px;
        font-size: 10.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .12em;
        color: var(--ink-500);
        box-shadow: var(--shadow-card);
        white-space: nowrap;
    }

    .chip-atualizacao-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--brand-500);
        display: inline-block;
        flex-shrink: 0;
    }

    /* Busca inline */
    .busca-tabela {
        display: flex;
        align-items: center;
        gap: 6px;
        border-radius: var(--radius-lg);
        border: 1px solid var(--ink-100);
        background: #fff;
        padding: 6px 10px;
        box-shadow: var(--shadow-card);
        font-size: 11.5px;
        color: var(--ink-500);
    }

        .busca-tabela i {
            font-size: 11px;
            color: var(--ink-300);
        }

        .busca-tabela input {
            width: 144px;
            background: transparent;
            border: none;
            font-size: 11.5px;
            color: var(--ink-900);
            font-family: inherit;
        }

            .busca-tabela input::placeholder {
                color: var(--ink-300);
            }

            .busca-tabela input:focus {
                outline: none;
            }

    /* Botão Apresentação */
    .btn-apresentacao {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: var(--radius-lg);
        background: #002A4D;
        padding: 6px 14px;
        font-size: 11.5px;
        font-weight: 700;
        font-family: inherit;
        color: #fff;
        box-shadow: var(--shadow-card);
        border: none;
        cursor: pointer;
        transition: background .15s, opacity .15s;
    }

        .btn-apresentacao:hover:not(:disabled) {
            background: #00437A;
        }

        .btn-apresentacao:disabled,
        .btn-apresentacao-off {
            opacity: .45;
            cursor: not-allowed;
        }

    /* Botão Preencher FPD (laranja Caixa) */
    .btn-fpd {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: var(--radius-lg);
        background: var(--amber-600);
        padding: 6px 14px;
        font-size: 11.5px;
        font-weight: 700;
        font-family: inherit;
        color: #fff;
        box-shadow: var(--shadow-card);
        border: none;
        cursor: pointer;
        transition: background .15s;
    }

        .btn-fpd:hover {
            background: var(--amber-700);
        }

    /* Botão Processar */
    .btn-processar {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: var(--radius-lg);
        background: var(--brand-700);
        padding: 6px 14px;
        font-size: 11.5px;
        font-weight: 700;
        font-family: inherit;
        color: #fff;
        box-shadow: var(--shadow-card);
        border: none;
        cursor: pointer;
        transition: background .15s;
    }

        .btn-processar:hover:not(:disabled) {
            background: var(--brand-800);
        }

        .btn-processar:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

    .btn-processando {
        opacity: .75 !important;
        cursor: wait !important;
    }

    /* ══════════════════════════════════════════════
       ÁREA DE CONTRATOS
       ══════════════════════════════════════════════ */
    .contratos-area {
        flex: 1;
        background: #F4F7FB;
    }

    .contratos-container {
        max-width: 1200px;
        margin: 0; /* alinhado à esquerda (junto ao menu), mas limitado em telas grandes */
        padding: 24px 32px 64px; /* sobra maior embaixo — a última tabela não pode terminar colada no rodapé */
    }

    /* Skeletons */
    .skeletons {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    /* Lista de grupos */
    .grupos-lista {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    /* ── Card de grupo ── */
    .grupo-card {
        overflow: hidden;
        border-radius: var(--radius-xl);
        border: 1px solid var(--ink-100);
        background: #fff;
        box-shadow: var(--shadow-card);
    }

    /* Header do card de grupo */
    .grupo-card-header {
        display: flex;
        align-items: center;
        padding: 14px 20px;
        background: #fff;
    }

        .grupo-card-header.com-borda {
            border-bottom: 1px solid var(--ink-100);
        }

    /* ── Cabeçalho de colunas (dentro de cada card) ── */
    .cols-header {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 8px 20px;
        background: #fff;
    }

    .col-h {
        font-size: 10px;
        font-weight: 700;
        color: var(--ink-500);
        text-transform: uppercase;
        letter-spacing: .08em;
        flex-shrink: 0;
    }

    /* ── Empty state ── */
    .tabela-vazia {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        padding: 80px 0;
        border-radius: var(--radius-xl);
        border: 1px dashed var(--ink-200);
        background: #fff;
        text-align: center;
        box-shadow: var(--shadow-card);
    }

        .tabela-vazia i {
            font-size: 32px;
            color: var(--ink-300);
        }

    .tabela-vazia-titulo {
        font-size: 15px;
        font-weight: 600;
        color: var(--ink-700);
    }

    .tabela-vazia-sub {
        font-size: 13px;
        color: var(--ink-500);
    }

    /* ── Popover de atribuição da lista ── */
    .overlay-atrib {
        position: fixed;
        inset: 0;
        z-index: 400;
        background: transparent;
    }

    .popover-atrib {
        position: fixed;
        z-index: 401;
        width: 220px;
        background: #fff;
        border: 1px solid var(--ink-100);
        border-radius: var(--radius-xl);
        box-shadow: 0 8px 24px rgba(0,0,0,.13), 0 2px 6px rgba(0,0,0,.07);
        overflow: hidden;
        animation: slideDown .15s ease;
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-6px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .popover-atrib-titulo {
        padding: 10px 14px;
        font-size: 9.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .12em;
        color: var(--ink-400);
        border-bottom: 1px solid var(--ink-100);
    }

    .popover-atrib-item {
        display: flex;
        align-items: center;
        gap: 9px;
        width: 100%;
        padding: 9px 14px;
        font-size: 12.5px;
        font-weight: 500;
        color: var(--ink-800);
        background: transparent;
        border: none;
        border-bottom: 1px solid var(--ink-50);
        cursor: pointer;
        transition: background .12s;
        font-family: inherit;
        text-align: left;
    }

        .popover-atrib-item:hover {
            background: var(--brand-50);
        }

    .popover-atrib-item-ativo {
        background: var(--brand-50);
        color: var(--brand-800);
        font-weight: 600;
    }

    .popover-atrib-avatar {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        color: #fff;
        font-size: 9px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .popover-atrib-nome {
        flex: 1;
    }

    .popover-atrib-check {
        color: var(--brand-600);
        font-size: 12px;
    }

    .popover-atrib-remover {
        width: 100%;
        padding: 9px 14px;
        font-size: 11.5px;
        font-weight: 500;
        color: var(--err);
        background: transparent;
        border: none;
        border-top: 1px solid var(--ink-100);
        cursor: pointer;
        text-align: left;
        font-family: inherit;
        transition: background .12s;
    }

        .popover-atrib-remover:hover {
            background: var(--err-bg);
        }
</style>
@{
    var todos           = _todos;
    var totalVal        = todos.Sum(d => d.ValidacoesTotal);
    var totalOk         = todos.Sum(d => d.ValidacoesOk);
    var qtdPendencias   = todos.Count(d => d.Status == "pendencia");
    var qtdPendentes    = todos.Count(d => d.Status == "pendente");
    // "Aprovado"/"Válidos" também mostra os finalizados (mesmo bucket lá na
    // origem — ver ControleAnaliseDesembolsoService.MapearStatus) e os
    // negados (senão desapareceriam da lista sem aparecer em nenhum grupo).
    var qtdAprovados    = todos.Count(d => d.Status is "aprovado" or "negado");
    var qtdAgendados    = todos.Count(d => d.Status == "agendado");

    var filtrados = _filtroAtivo switch
    {
        "invalidos" => todos.Where(d => d.Status == "pendencia").ToList(),
        "pendentes" => todos.Where(d => d.Status == "pendente").ToList(),
        "validos"   => todos.Where(d => d.Status is "aprovado" or "negado").ToList(),
        "agendado"  => todos.Where(d => d.Status == "agendado").ToList(),
        // "rejeitado" => todos.Where(d => d.Status == "negado").ToList(), // filtro dedicado — descomentar pra habilitar a pill "Rejeitado"
        _           => todos
    };
    // var podePresentar = filtrados.Count >= 2;   // usado pelo botão Apresentação (desabilitado)

    // Busca aplicada antes do agrupamento: grupos, contagens e estado vazio
    // reagem juntos ao que foi digitado. Nenhuma aba pagina aqui — a única
    // lista que cresce sem limite é a de DRP (baixa de todos os desembolsos),
    // que tem paginação e filtro de período próprios em TabelaBaixaDrp.
    var buscados = AplicarBusca(filtrados);

    var grupoPendencias = buscados.Where(d => d.Status == "pendencia").ToList();
    var grupoPendentes  = buscados.Where(d => d.Status == "pendente").ToList();
    var grupoAprovados  = buscados.Where(d => d.Status == "aprovado").ToList();
    var grupoAgendados  = buscados.Where(d => d.Status == "agendado").ToList();
    // Rejeitados têm grupo próprio (sempre por último) — só os dos últimos 15
    // dias, senão a lista cresce pra sempre. Continuam contando dentro de
    // "Válidos"/qtdAprovados lá em cima (comportamento de antes, não mexi).
    var limiteRejeitados = DateTime.Today.AddDays(-15);
    var grupoRejeitados = buscados.Where(d => d.Status == "negado" && d.DtConclusao >= limiteRejeitados).ToList();
}

<div class="pagina">

    <!-- ══ Seção Header ══ -->
    <section class="pagina-header-secao">
        <div class="pagina-header-container">
           
            <h1 class="pagina-titulo">
                Análise de <span class="titulo-destaque">Desembolsos</span>
            </h1>

            <!-- Stats Consolidado -->
            <div class="stats-consolidado">
                <div class="stats-consolidado-header">
                    <span class="stats-consolidado-titulo">Relatório Consolidado</span>
                </div>
                <div class="stats-consolidado-cells">

                    <div class="stats-cell">
                        <div class="stats-cell-icon" style="background:#EBF5FF">
                            <i class="bi bi-list-check" style="color:#005CA9;font-size:14px"></i>
                        </div>
                        <div>
                            <div class="stats-cell-valor">@todos.Count</div>      
                            <div class="stats-cell-label">Total de contratos</div>                      
                        </div>
                    </div>

                    <div class="stats-cell">
                        <div class="stats-cell-icon" style="background:#FEF2F2">
                            <i class="bi bi-exclamation-triangle" style="color:#C0392B;font-size:14px"></i>
                        </div>
                        <div>
                            <div class="stats-cell-valor">@qtdPendencias</div>
                            <div class="stats-cell-label">Com pendência</div>
                        </div>
                    </div>

                    <div class="stats-cell">
                        <div class="stats-cell-icon" style="background:#FFFBEB">
                            <i class="bi bi-clock" style="color:#D87B00;font-size:14px"></i>
                        </div>
                        <div>
                            <div class="stats-cell-valor">@qtdPendentes</div>
                            <div class="stats-cell-label">Para analisar</div>
                        </div>
                    </div>

                    <div class="stats-cell">
                        <div class="stats-cell-icon" style="background:#F0FDF4">
                            <i class="bi bi-check-circle" style="color:#1A7A4A;font-size:14px"></i>
                        </div>
                        <div>
                            <div class="stats-cell-valor">@qtdAprovados</div>
                            <div class="stats-cell-label">Aprovados</div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </section>

    <!-- ══ Barra de filtros + toolbar ══
         Dois grupos visuais, separados por função (não só por lado):
         "grupo-consulta" = tudo que estreita o que aparece na lista (pills de
         status, período, busca); "grupo-acoes" = tudo que faz alguma coisa
         (criar FPD, processar) — com um separador fino entre os dois. ══ -->
    <div class="filtros-area">
        <div class="filtros-container">

            <div class="grupo-consulta">
                <!-- Pill segmentado -->
                <div class="filtro-pill">
                    <button class="filtro-btn @(_filtroAtivo == "geral"     ? "filtro-btn-ativo" : "")" @onclick='() => SelecionarFiltro("geral")'>
                        <span class="filtro-dot" style="background:#9EB2BB;opacity:@(_filtroAtivo=="geral"?"1":"0.5")"></span>
                        Geral
                        <span class="filtro-badge @(_filtroAtivo == "geral" ? "filtro-badge-ativo" : "")">@todos.Count</span>
                    </button>

                    <button class="filtro-btn @(_filtroAtivo == "invalidos" ? "filtro-btn-ativo" : "")" @onclick='() => SelecionarFiltro("invalidos")' title="FPDs que acabaram de entrar, aguardando a 1ª validação da macro">
                        <span class="filtro-dot" style="background:#C0392B;opacity:@(_filtroAtivo=="invalidos"?"1":"0.5")"></span>
                        Aguardando
                        @if (qtdPendencias > 0)
                        {
                            <span class="filtro-badge @(_filtroAtivo == "invalidos" ? "filtro-badge-ativo" : "")">@qtdPendencias</span>
                        }
                    </button>

                    <button class="filtro-btn @(_filtroAtivo == "pendentes" ? "filtro-btn-ativo" : "")" @onclick='() => SelecionarFiltro("pendentes")'>
                        <span class="filtro-dot" style="background:#D87B00;opacity:@(_filtroAtivo=="pendentes"?"1":"0.5")"></span>
                        Analisar
                        @if (qtdPendentes > 0)
                        {
                            <span class="filtro-badge @(_filtroAtivo == "pendentes" ? "filtro-badge-ativo" : "")">@qtdPendentes</span>
                        }
                    </button>

                    <button class="filtro-btn @(_filtroAtivo == "validos"   ? "filtro-btn-ativo" : "")" @onclick='() => SelecionarFiltro("validos")'>
                        <span class="filtro-dot" style="background:#1A7A4A;opacity:@(_filtroAtivo=="validos"?"1":"0.5")"></span>
                        Válidos
                        @if (qtdAprovados > 0)
                        {
                            <span class="filtro-badge @(_filtroAtivo == "validos" ? "filtro-badge-ativo" : "")">@qtdAprovados</span>
                        }
                    </button>

                    <button class="filtro-btn @(_filtroAtivo == "agendado"  ? "filtro-btn-ativo" : "")" @onclick='() => SelecionarFiltro("agendado")' title="Desembolsos SANEPAR — aguardam a rotina do dia 20 pra entrar na fila normal">
                        <span class="filtro-dot" style="background:#2D8AD8;opacity:@(_filtroAtivo=="agendado"?"1":"0.5")"></span>
                        Agendado
                        @if (qtdAgendados > 0)
                        {
                            <span class="filtro-badge @(_filtroAtivo == "agendado" ? "filtro-badge-ativo" : "")">@qtdAgendados</span>
                        }
                    </button>

                    @* Filtro dedicado "Rejeitado" — comentado a pedido do usuário. Pra
                       habilitar: descomenta aqui, descomenta o case "rejeitado" no switch
                       de `filtrados` lá em cima, e adiciona uma var `qtdRejeitados` (ex.:
                       `todos.Count(d => d.Status == "negado")`) se quiser o contador. *@
                    @*
                    <button class="filtro-btn @(_filtroAtivo == "rejeitado" ? "filtro-btn-ativo" : "")" @onclick='() => SelecionarFiltro("rejeitado")'>
                        <span class="filtro-dot" style="background:#7A1F16;opacity:@(_filtroAtivo=="rejeitado"?"1":"0.5")"></span>
                        Rejeitado
                        @if (todos.Count(d => d.Status == "negado") > 0)
                        {
                            <span class="filtro-badge @(_filtroAtivo == "rejeitado" ? "filtro-badge-ativo" : "")">@todos.Count(d => d.Status == "negado")</span>
                        }
                    </button>
                    *@

                    <button class="filtro-btn @(_filtroAtivo == "drp"  ? "filtro-btn-ativo" : "")" @onclick='() => SelecionarFiltro("drp")'>
                        <span class="filtro-dot" style="background:#1074C8;opacity:@(_filtroAtivo=="drp"?"1":"0.5")"></span>
