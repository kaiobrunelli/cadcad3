                    </div>
                }
            </div>

            <!-- Ações (ocultas na aba DRP, que tem ação própria) -->
            @if (_filtroAtivo != "drp")
            {
            <div class="grupo-acoes">
                @* "Preencher FPD" (versão sem etapas) desativado — DialogPreencherFpd
                   está inteiro comentado (nunca foi ligado a nada real). O fluxo
                   definitivo é o "Preencher FPD (Etapas)" logo abaixo. *@
                @*
                <button class="btn-fpd" @onclick="() => _fpdAberto = true" title="Registrar Ficha de Previsão de Desembolso">
                    <i class="bi bi-clipboard-plus"></i>
                    <span>Preencher FPD</span>
                </button>
                *@

                @* Validar Pendentes é ação exclusiva de CEFGA (7175) — quem analisa,
                   não quem solicita. *@
                @if (!ServicoUsuario.EhGigov)
                {
                    <button class="btn-processar @(_processando ? "btn-processando" : "")" @onclick="ExecutarMacro" disabled="@_processando"
                            title="Roda a validação em lote pra todo desembolso ainda no status inicial (pendência)">
                        <i class="bi bi-@(_processando ? "hourglass-split" : "shield-check")"></i>
                        <span>@(_processando ? "Validando..." : "Validar Pendentes")</span>
                    </button>
                }

                @* Preencher FPD é ação exclusiva de GIGOV — quem solicita, não quem analisa. *@
                @if (ServicoUsuario.EhGigov)
                {
                    <button class="btn-fpd" @onclick="() => _fpdEtapasAberto = true" title="Registrar Ficha de Previsão de Desembolso em etapas">
                        <i class="bi bi-plus-lg"></i>
                        <span>Preencher FPD</span>
                    </button>
                }

                @* Botão Apresentação ocultado — a página /apresentacao continua na
                   aplicação (acessível pelo menu lateral) *@
            </div>
            }

        </div>
    </div>

    <!-- ══ Barra de progresso do processamento ══ -->
    <BarraProgresso />

    <!-- ══ Lista de contratos ══ -->
    <div class="contratos-area">
        <div class="contratos-container">

            @if (_filtroAtivo == "drp")
            {
                <!-- Aba DRP: tabela de controle de baixa -->
                <TabelaBaixaDrp />
            }
            else if (_carregando)
            {
                <div class="skeletons">
                    @for (int i = 0; i < 6; i++)
                    {
                        <div class="skeleton" style="height:56px;border-radius:var(--radius-xl)"></div>
                    }
                </div>
            }
            else
            {
                <div class="grupos-lista">

                    <!-- Grupo: Inválidos -->
                    @if (grupoPendencias.Any())
                    {
                        <section class="grupo-card">
                            <div class="grupo-card-header @(_grupoPendenciasAberto ? "com-borda" : "")">
                                <CabecalhoGrupo Titulo="Aguardando Validação"
                                                Contagem="@grupoPendencias.Count"
                                                Tipo="pendencia"
                                                Aberto="@_grupoPendenciasAberto"
