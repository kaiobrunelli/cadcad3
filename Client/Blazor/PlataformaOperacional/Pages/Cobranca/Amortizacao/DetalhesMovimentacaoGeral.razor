<MudTd ColSpan="5" Class="pa-0">
	<MudSimpleTable Dense Elevation="0" Style="background-color:#f5f5f5;" Bordered=true>
		<colgroup>
			<col style="width: 15%;" />
			<col />
			<col style="width: 22%;" />
			<col style="width: 50%;" />
		</colgroup>
		<thead>
			<tr>
				<th class="text-center">Data Crédito</th>
				<th class="text-center">GIFUG</th>
				<th class="text-center">Saldo Devedor</th>
				<th class="text-center">Log Carga</th>
			</tr>
		</thead>
		<tbody>
			<tr>
				<td class="text-center">
					<MudField Typo="Typo.body2" Variant="Variant.Text" Underline="false">
						@ConverterData(Item.DtCredito)
					</MudField>
				</td>
				<td class="text-center">
					<MudField Typo="Typo.body2" Variant="Variant.Text" Underline="false">
						@Item.CoGifug
					</MudField>
				</td>
				<td class="text-center">
					<MudField Typo="Typo.body2" Variant="Variant.Text" Underline="false">
						@ConverterValor(Item.SaldoDevedorConsiderado)
					</MudField>
				</td>
				<td>
					<MudField Typo="Typo.body2" Variant="Variant.Text" Underline="false">
						@Item.LogApontamentos
					</MudField>
				</td>
			</tr>
		</tbody>
	</MudSimpleTable>
</MudTd>

@code {

    [Parameter] public MovimentacaoGeral Item { get; set; }

	private string ConverterData(DateTime? data)
	{
		if (data.HasValue)
		{
			return data.Value.ToString("dd/MM/yy");
		}
		return string.Empty;
	}
	private string ConverterValor(decimal? valor)
	{

		return "R$ " + (valor.HasValue
				? valor.Value.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))
				: "0,00");

	}
}