@namespace Plataforma.Components.Shared

<div class="metric @Kind @(Clickable ? "is-clickable" : "")"
     @onclick="HandleClick"
     role="@(Clickable ? "button" : null)"
     tabindex="@(Clickable ? 0 : -1)">
    <div class="metric-top">
        <span class="metric-label">@Label</span>
        @if (Clickable)
        {
            <span class="metric-badge">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"/>
                </svg>
            </span>
        }
    </div>

    <div class="metric-count">@Count.ToString("D2")</div>
    <div class="metric-unit">@(Count == 1 ? "registro" : "registros")</div>

    @if (Clickable)
    {
        <div class="metric-action">
            <span>Ver detalhes</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
            </svg>
        </div>
    }
</div>

@code {
    [Parameter] public string        Label     { get; set; } = "";
    [Parameter] public int           Count     { get; set; }
    [Parameter] public string        Kind      { get; set; } = "";
    [Parameter] public bool          Clickable { get; set; }
    [Parameter] public EventCallback OnClick   { get; set; }

    private Task HandleClick()
        => Clickable && OnClick.HasDelegate ? OnClick.InvokeAsync() : Task.CompletedTask;
}
