@using PlataformaOperacional.Model.DesembososModel
@using System.Globalization

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">

            <MudPaper Elevation="0" Style="padding:16px; border-radius:12px; background-color:#f8fafc;">
                <MudStack Spacing="1">
                    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.subtitle2" Style="color:#64747a;">TO01</MudText>
                        @if (Desembolso.VrTo01.HasValue)
                        {
                            <MudText Typo="Typo.body2" Style="font-weight:400; color:#22292e;">@Desembolso.VrTo01.Value.ToString("'R$' #,##0.00", new CultureInfo("pt-BR"))</MudText>
                        }
                    </MudStack>
                    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
