    return new TmCardInfo(
        Title: tipoMovimentacao,
        Quantity: resumo?.QtEntradas ?? 0,
        Value: resumo?.VrTotal ?? 0m,
        Gradient: gradient);
}

private static bool ShouldShowPhase(string? situacao)
{
    return Contains(situacao, "Pendente")
        || Contains(situacao, "Erro")
        || Contains(situacao, "Sucesso");
}

private static Color GetPhaseColor(string? situacao)
{
    if (Contains(situacao, "Erro"))
        return Color.Error;

    if (Contains(situacao, "Sucesso"))
        return Color.Success;

    return Color.Warning;
}

private static Severity GetPhaseSeverity(string? situacao)
{
    if (Contains(situacao, "Erro"))
        return Severity.Error;

    if (Contains(situacao, "Sucesso"))
        return Severity.Success;

    return Severity.Warning;
}

private static string GetTmCardClass(TmCardInfo card)
{
    return card.HasValue
        ? "tm-card"
        : "tm-card tm-card-empty";
}

private static string FormatCurrency(decimal? value)
{
    return (value ?? 0m).ToString("'R$' #,##0.00", PtBr);
}

private static bool Contains(string? source, string value)
{
    return source?.Contains(value, IgnoreCase) == true;
}

private sealed record TmCardInfo(
    string Title,
    long? Quantity,
    decimal? Value,
    string Gradient)
{
    public bool HasValue =>
        Quantity.GetValueOrDefault() > 0 ||
        Value.GetValueOrDefault() > 0m;
}

private sealed record FaseInfo(
    int Id,
    string Situacao,
    string Descricao);


private async Task AbrirConfiguracoes()
{
    var options = new DialogOptions
    {
        MaxWidth = MaxWidth.Large,
        FullWidth = true,
        CloseButton = true,
        CloseOnEscapeKey = true,
        BackdropClick = true
    };

    await DialogService.ShowAsync<DialogConfiguracoesDesembolsos>(
        "Configurações de Desembolsos",
        options);
}

private IBrowserFile? _arquivo;

private async Task OnFileSelected(IBrowserFile arquivo)
{
    _arquivo = arquivo;

    await EnviarArquivo();
    _arquivo = null;
}

private async Task EnviarArquivo()
{
    if (_arquivo is null)
    {
        Snackbar.Add("Arquivo não selecionado.", Severity.Warning);
        return;
    }

    var response = await Service.ProcessarValidacaoAsync(_arquivo);
    await HttpResponseHandler.ResponseHandler(response, Snackbar);


}

