private string ProcessarButtonText =>
    _areaSelecionada == AreaOperacional.DRPs
        ? "BAIXAR DRPS"
        : "PROCESSAR";

protected override async Task OnInitializedAsync()
{
    await CarregarPaginaAsync();
}

private void OnActiveTabIndexChanged(int index)
{
    _activeTabIndex = index;

    _areaSelecionada = index switch
    {
        0 => AreaOperacional.Desembolsos,
        1 => AreaOperacional.DRPs,
        _ => AreaOperacional.Desembolsos
    };

    _desembolsosSelecionados = [];
    DefineFaseInicial();
    AtualizarEstadoDaFase();
}

private async Task CarregarPaginaAsync()
{
    _carregandoCards = true;
    _carregandoTabela = true;
    _processarDesabilitado = true;
    _criarFluxoDesabilitado = true;

    try
    {
        ResetPageBeforeLoad();

        var controlesDoUsuario = await SendAsync<List<Controle>>(
            Service.ConsultarControlesExecucaoPorMatricula()) ?? [];

        if (controlesDoUsuario.Count > 0)
        {
            _controleAtual = controlesDoUsuario.First();

            SetSituacoesFromControle(forceCargaSuccess: true);

            await CarregarDesembolsosFluxoAsync();

            _drpsEmissao = await SendAsync<List<Drp>>(Service.ConsultarDrpsPendentes()) ?? [];
        }
        else
        {
            _descSituacaoCarga = "Fase atual: Selecionar desembolsos e Criar Fluxo";
            _drpsEmissao = [];
        }

        await CarregarDesembolsosPendentesAsync();

        await CarregarResumoCardsAsync();

        desembolsosLancados = Contains(_situacaoDesembolsos, "Sucesso");

        drpsEmitidas =
            Contains(_situacaoDrpsEmissao, "Sucesso") ||
            Contains(_descSituacaoDrpsEmissao, "Sucesso");

        await CarregarDesembolsosNaoSelecionadosAsync();
        await CarregarDrpsAsync();

        DefineFaseInicial();
        AtualizarEstadoDaFase();
    }
    catch (Exception ex)
    {
        Snackbar.Add($"Falha ao carregar página. {ex.Message}", Severity.Error);

        _desembolsos = [];
        _desembolsosFluxo = [];
        _desembolsosNaoSelecionados = [];
        _desembolsosSelecionados = [];
        _drpsEmissao = [];
        _drpsBaixa = [];
        _drpsFinalizadas = [];
        _resumoCards = [];

        _processarDesabilitado = true;
    }
    finally
    {
        _carregandoCards = false;
        _carregandoTabela = false;
        StateHasChanged();
    }
}

private void ResetPageBeforeLoad()
{
    _desembolsosSelecionados = [];
    _mensagemErro = string.Empty;
    _senhaCriptografada = string.Empty;
}

private async Task CarregarResumoCardsAsync()
{
    try
    {
        _resumoCards = await SendAsync<List<ResumoCards>>(
            Service.ConsultarResumoCards()) ?? [];
    }
    catch
    {
        _resumoCards = [];
        Snackbar.Add("Falha ao carregar resumo consolidado dos cards.", Severity.Warning);
    }
}

private async Task CarregarDesembolsosPendentesAsync()
{
    try
    {
        await Service.AtualizarListaDesembolsos();
    }
    catch (Exception ex)
    {
        Snackbar.Add("Falha ao obter dados da esteira: " + ex.Message, Severity.Error);
        _desembolsos = [];
    }

    try
    {
        _desembolsos = await SendAsync<List<Desembolso>>(
            Service.ConsultarDesembolsosPendentes()) ?? [];
    }
    catch
    {
        _desembolsos = [];
    }
}

private async Task CarregarDesembolsosFluxoAsync()
{
    try
    {
        _desembolsosFluxo = await SendAsync<List<Desembolso>>(
            Service.ConsultarDesembolsosPorFluxo()) ?? [];

        _desembolsosSelecionados = [];
    }
    catch
    {
        _desembolsosFluxo = [];
    }
}

private async Task CarregarDesembolsosNaoSelecionadosAsync()
{
    try
    {
        _desembolsosNaoSelecionados = await SendAsync<List<Desembolso>>(
            Service.ConsultarDesembolsosNaoSelecionados()) ?? [];
    }
    catch
    {
        _desembolsosNaoSelecionados = [];
    }
}

private async Task CarregarDrpsAsync()
{
    try
    {
        _drpsBaixa = await SendAsync<List<Drp>>(
            Service.ConsultarDrpsParaBaixa()) ?? [];

        _drpsFinalizadas = await SendAsync<List<Drp>>(
            Service.ConsultarDrpsFinalizadas()) ?? [];
    }
    catch
    {
        _drpsBaixa = [];
        _drpsFinalizadas = [];
    }
}

private async Task<T?> SendAsync<T>(Task<HttpResponseMessage> request)
    where T : notnull
{
    var response = await request;
    return await HttpResponseHandler.ResponseHandler<T>(response, Snackbar);
}

private void SetSituacoesFromControle(bool forceCargaSuccess)
{
    _situacaoCarga = forceCargaSuccess
        ? "Sucesso"
        : Required(_controleAtual.SituacaoCarga, "Situação da carga não identificada.");

    _descSituacaoCarga = forceCargaSuccess
        ? "Fluxo criado com sucesso."
        : Required(_controleAtual.DescSituacaoCarga, "Descrição da carga não identificada.");

    _situacaoDesembolsos = Required(_controleAtual.SituacaoDesembolsos, "Situação dos desembolsos não identificada.");
    _descSituacaoDesembolsos = Required(_controleAtual.DescSituacaoDesembolsos, "Descrição dos desembolsos não identificada.");

    _situacaoDrpsEmissao = Required(_controleAtual.SituacaoDrpEmissao, "Situação das DRPs não identificada.");
    _descSituacaoDrpsEmissao = Required(_controleAtual.DescSituacaoDrpEmissao, "Descrição das DRPs não identificada.");

    _situacaoDrpsBaixa = Required(_controleAtual.SituacaoDrpBaixa, "Situação da baixa das DRPs não identificada.");
    _descSituacaoDrpsBaixa = Required(_controleAtual.DescSituacaoDrpBaixa, "Descrição da baixa das DRPs não identificada.");

    _situacaoFinalizacao = Required(_controleAtual.SituacaoFinalizacao, "Situação da finalização não identificada.");
    _descSituacaoFinalizacao = Required(_controleAtual.DescSituacaoFinalizacao, "Descrição da finalização não identificada.");
}

private static string Required(string? value, string errorMessage)
{
    return string.IsNullOrWhiteSpace(value)
        ? throw new NullReferenceException(errorMessage)
        : value;
}

private void DefineFaseInicial()
{
    _faseReal =
        Contains(_situacaoDrpsBaixa, "Sucesso") ? 5 :
        Contains(_situacaoDrpsEmissao, "Sucesso") ? 4 :
        Contains(_situacaoDesembolsos, "Sucesso") ? 3 :
        Contains(_situacaoCarga, "Sucesso") ? 2 :
        1;

    _fase = _areaSelecionada switch
    {
        AreaOperacional.Desembolsos => _faseReal <= 3 ? _faseReal : 3,
        AreaOperacional.DRPs => _faseReal >= 4 ? _faseReal : 4,
        _ => _faseReal
    };
}

private void AlterarFase(int fase)
{
    if (!CanAccessFase(fase))
        return;

    _fase = fase;
    AtualizarEstadoDaFase();
}

private bool CanAccessFase(int fase)
{
    return _areaSelecionada switch
    {
        AreaOperacional.Desembolsos => fase >= 1 && fase <= 3,
        AreaOperacional.DRPs => fase >= 4 && fase <= 5,
        _ => false
    };
}

private string GetPhaseAlertClass(int fase)
{
    return CanAccessFase(fase)
        ? "cursor-pointer phase-alert"
        : "phase-alert-disabled";
}

private Color GetTimelineItemColor(FaseInfo fase)
{
    if (IsEmissaoWaitingPhase3 && fase.Id == 3)
        return Color.Info;

    return GetPhaseColor(fase.Situacao);
}

private Severity GetTimelineSeverity(FaseInfo fase)
{
    if (IsEmissaoWaitingPhase3 && fase.Id == 3)
        return Severity.Info;

    return GetPhaseSeverity(fase.Situacao);
}

private Color GetTimelineColor(FaseInfo fase)
{
    if (IsEmissaoWaitingPhase3 && fase.Id == 3)
        return Color.Info;

    return GetPhaseColor(fase.Situacao);
}

private string GetTimelineIcon(FaseInfo fase)
{
    if (IsEmissaoWaitingPhase3 && fase.Id == 3)
        return Icons.Material.Filled.LockClock;

    return string.Empty;
}

private void AtualizarEstadoDaFase()
{
    _tabelaTitulo = _areaSelecionada switch
    {
        AreaOperacional.Desembolsos => _fase switch
        {
            1 => HasFluxo ? "Desembolsos selecionados" : "Desembolsos disponíveis",
            2 => "Desembolsos selecionados",
            3 when EmissaoAguardandoBaixa => "Aguardando baixa de DRPs por outro empregado",
            3 => "DRPs a emitir",
            _ => string.Empty
        },

        AreaOperacional.DRPs => _fase switch
        {
            4 => "DRPs disponíveis para baixa",
            5 => "Finalização",
            _ => "DRPs disponíveis para baixa"
        },

        _ => string.Empty
    };

    cancelarFluxoDesabilitado = !Contains(_situacaoDesembolsos, "Pendente");

    _criarFluxoDesabilitado =
        _areaSelecionada != AreaOperacional.Desembolsos ||
        _desembolsosSelecionados.Count == 0 ||
        HasFluxo;

    _processarDesabilitado = _areaSelecionada switch
    {
        AreaOperacional.Desembolsos => _fase switch
        {
            2 => _desembolsosFluxo.Count == 0 || desembolsosLancados,
            3 when EmissaoAguardandoBaixa => true,
            3 => _drpsEmissao.Count == 0 || drpsEmitidas,
            _ => true
        },

        AreaOperacional.DRPs => _fase switch
        {
            4 => _drpsBaixa.Count == 0 || HasFluxo,
            _ => true
        },

        _ => true
    };
}

private Func<Desembolso, bool> _quickFilter => item =>
{
    if (string.IsNullOrWhiteSpace(_searchString))
        return true;

    return item.Tomador?.Contains(_searchString, IgnoreCase) == true;
};

private void SelectedItemsChanged(HashSet<Desembolso> items)
{
    _desembolsosSelecionados = items.ToList();
    AtualizarEstadoDaFase();
}

private async Task CriarFluxo(List<Desembolso> desembolsos)
{
    if (_processando)
        return;

    if (_areaSelecionada != AreaOperacional.Desembolsos)
        return;

    if (desembolsos is null || desembolsos.Count == 0)
    {
        Snackbar.Add("Nenhum desembolso selecionado para criação do fluxo.", Severity.Warning);
        return;
    }

    if (desembolsos.Any(x => string.IsNullOrWhiteSpace(x.NuContrato)))
    {
        Snackbar.Add("Existem desembolsos sem número de contrato.", Severity.Error);
        return;
    }

    if (desembolsos.Any(x => string.IsNullOrWhiteSpace(x.Fid)))
    {
        Snackbar.Add("Existem desembolsos sem FID.", Severity.Error);
        return;
    }

    var desembolsosFluxo = desembolsos
        .Select(x => new DesembolsoFluxoDto(
            x.NuContrato!.Trim(),
            x.Fid!.Trim()))
        .ToList();

    var confirmado = await ConfirmarCriacaoFluxoAsync(desembolsos);

    if (!confirmado)
        return;

    await ExecuteWithProcessingAsync(
        operation: () => Service.CriarFluxoDesembolsos(desembolsosFluxo),
        successMessage: "Fluxo criado com sucesso.",
        errorPrefix: "Falha ao criar fluxo: ",
        after: CarregarPaginaAsync);
}

private async Task<bool> ConfirmarCriacaoFluxoAsync(List<Desembolso> desembolsos)
{
    var parameters = new DialogParameters<CriarFluxoDialog>
        {
            { x => x.Desembolsos, desembolsos }
        };

    var options = new DialogOptions
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = false,
        CloseButton = true,
        BackdropClick = false,
        NoHeader = true
    };

    var dialog = await DialogService.ShowAsync<CriarFluxoDialog>(
        title: string.Empty,
        parameters,
        options);

    var result = await dialog.Result;

    return result is { Canceled: false };
}

protected async Task CancelarFluxo()
{
    if (_processando)
        return;

    if (_areaSelecionada != AreaOperacional.Desembolsos)
        return;

    var confirmed = await DialogService.ShowMessageBoxAsync(
        title: "Confirmar cancelamento",
        markupMessage: (MarkupString)"Deseja mesmo <strong style='color: var(--mud-palette-error);'>cancelar o fluxo</strong> de desembolsos?",
        yesText: "Confirmar",
        cancelText: "Voltar",
        options: new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = false,
            CloseButton = true,
            BackdropClick = false
        });

    if (confirmed != true)
        return;

    await ExecuteWithProcessingAsync(
        operation: () => Service.CancelarFluxoDesembolsos(_controleAtual.CoControle),
        successMessage: "Fluxo cancelado com sucesso.",
        errorPrefix: "Falha ao cancelar fluxo: ",
        after: async () =>
        {
            _desembolsosFluxo = [];

            if (_areaSelecionada == AreaOperacional.Desembolsos)
                _fase = 1;

            await CarregarPaginaAsync();

            AtualizarEstadoDaFase();
        });
}

private async Task ProcessarMovimentoAsync()
{
    if (_processando)
        return;

    if (!BotaoProcessarVisivel || _processarDesabilitado)
        return;

    List<int> controlesBaixa = [];


    if (_areaSelecionada == AreaOperacional.DRPs)
    {
        controlesBaixa = _drpsBaixa
            .Select(drp => drp.CoControle)
            .Distinct()
            .ToList();

        if (controlesBaixa.Count == 0)
        {
            Snackbar.Add("Nenhuma DRP disponível para baixa.", Severity.Warning);
            return;
        }
    }

    var title = _areaSelecionada == AreaOperacional.DRPs
        ? "Baixar DRPs"
        : "Processar desembolsos";

    var parameters = new DialogParameters<BoxSenha>
        {
            { x => x.Title, title }
        };

    var options = new DialogOptions
    {
        CloseOnEscapeKey = true,
        MaxWidth = MaxWidth.ExtraSmall,
        FullWidth = false
    };

    var dialog = await DialogService.ShowAsync<BoxSenha>(
        title: string.Empty,
        parameters,
        options);

    var result = await dialog.Result;

    if (result is not { Canceled: false })
        return;

    if (result.Data is null)
    {
        Snackbar.Add("Dados inválidos.", Severity.Error);
        return;
    }

    _senhaCriptografada = result.Data.ToString() ?? string.Empty;

    var successMessage = _areaSelecionada == AreaOperacional.DRPs
        ? "Baixa realizada com sucesso."
        : "Processamento realizado com sucesso.";

    var errorPrefix = _areaSelecionada == AreaOperacional.DRPs
        ? "Falha ao processar baixa: "
        : "Falha ao processar movimento: ";


    Func<Task<HttpResponseMessage>> operation = _areaSelecionada switch
    {
        AreaOperacional.Desembolsos =>
            () => Service.ProcessarDesembolsos(new SenhaUsuario(_senhaCriptografada)),

        AreaOperacional.DRPs =>
            () => Service.ProcessarDesembolsosBaixa(
                new DesembolsoAutomacaoDados(_senhaCriptografada, controlesBaixa: controlesBaixa)),

        _ =>
            throw new InvalidOperationException("Área operacional inválida.")
    };

    await ExecuteWithProcessingAsync(
        operation: operation,
        successMessage: successMessage,
        errorPrefix: errorPrefix,
        after: CarregarPaginaAsync);
}

private async Task ExecuteWithProcessingAsync(
    Func<Task<HttpResponseMessage>> operation,
    string successMessage,
    string errorPrefix,
    Func<Task>? after = null)
{
    if (_processando)
        return;

    _processando = true;
    AtualizarEstadoDaFase();
    StateHasChanged();

    try
    {
        var response = await operation();
        await HandleServiceResponseAsync(response, successMessage, errorPrefix);
    }
    catch (TaskCanceledException ex) when (ex.InnerException is TimeoutException)
    {
        Snackbar.Add(
            "O tempo limite da requisição foi excedido. Atualize a página em alguns instantes.",
            Severity.Error);
    }
    finally
    {
        _processando = false;

        if (after is not null)
            await after();

        AtualizarEstadoDaFase();
        StateHasChanged();
    }
}

private async Task HandleServiceResponseAsync(
    HttpResponseMessage response,
    string successMessage,
    string errorPrefix)
{
    if (response.IsSuccessStatusCode)
    {
        Snackbar.Add(successMessage, Severity.Success);
        return;
    }

    if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
    {
        Snackbar.Add("Usuário não autorizado para executar esta operação.", Severity.Error);
        return;
    }

    if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
    {
        Snackbar.Add("Usuário sem permissão para executar esta operação.", Severity.Error);
        return;
    }

    _mensagemErro = await ExtractErrorMessageAsync(response);
    Snackbar.Add(errorPrefix + _mensagemErro, Severity.Error);
}

private async Task<string> ExtractErrorMessageAsync(HttpResponseMessage response)
{
    try
    {
        _resultado = await response.Content.ReadFromJsonAsync<ResultadoFlunt>();

        return _resultado?.Notifications?.FirstOrDefault()?.Message
            ?? "Erro desconhecido.";
    }
    catch (Exception ex)
    {
        var content = await response.Content.ReadAsStringAsync();

        return string.IsNullOrWhiteSpace(content)
            ? ex.Message
            : content;
    }
}

