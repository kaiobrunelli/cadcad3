		<MudText Typo="Typo.body2" Style="color:#red"><b>C151896</b></MudText>
		<MudChip Style="min-width:32px"
				 Variant="Variant.Text"
				 Size="Size.Small"
				 T="string" Color="Color.Success">Eventual</MudChip>
