			<MudIconButton Icon="@Icons.Material.Filled.PersonAdd"></MudIconButton>
			<MudIconButton Icon="@Icons.Material.Filled.PersonRemove"></MudIconButton>
		</MudStack>
	</MudStack>
</MudPaper>

