@using System.Globalization
@inject PreditorService PreditorService
<style>
	:root {
		-mud-palette-background-grey: #f6f6f8 !important;
	}

	.valores-preditor {
		background-color: #f6f6f8;
		border: 1px solid #e5e7eb;
	}

	.mud-input > input.mud-input-root {
		margin-top: 0px !important;
	}

	.rounded-custom {
		border-radius: 12px;
	}


	.rounded-custom {
		border-radius: 12px;
	}

	.input-wrapper {
		position: relative;
		display: flex;
		align-items: center;
		width: 100%;
	}

	.currency-symbol {
		position: absolute;
		left: 12px;
		color: #64748b; /* slate-500 */
		font-weight: 500;
		pointer-events: none; /* impede que o usuário clique no R$ */
	}

	.input-field::-webkit-outer-spin-button,
	.input-field::-webkit-inner-spin-button {
		-webkit-appearance: none;
		margin: 0;
	}



	.input-field {
		width: 100%;
		-moz-appearance: textfield;
		appearance: textfield;
		padding: 12px 12px 12px 35px; /* O padding-left (35px) abre espaço para o R$ */
		border-radius: 0.75rem; /* rounded-xl */
		background-color: #f8fafc; /* bg-slate-50 */
		border: 1px solid #e2e8f0;
		font-size: 0.95rem;
		outline: none;
		font-weight: 400;
		transition: border-color 0.2s;
	}

		.input-field:focus {
			border-color: #594AE2; /* Seu azul muddraw */
			box-shadow: 0 0 0 2px rgba(0, 92, 169, 0.1);
		}
</style>

