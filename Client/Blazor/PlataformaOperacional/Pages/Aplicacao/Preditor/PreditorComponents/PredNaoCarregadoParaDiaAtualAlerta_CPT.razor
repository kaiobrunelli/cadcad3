<MudContainer MaxWidth="MaxWidth.Large" Class="mt-2 ">
	<MudGrid>
		<MudItem md="12" , lg="12">
			<MudPaper Class="rounded-custom border border-solid mud-border-lines-default pa-6 relative overflow-hidden" Elevation="0">
				<MudStack Row="false" AlignItems="AlignItems.Center">
					<MudText Color=Color.Primary Typo="Typo.h5">
						Preditor não carregado para o dia @DateTime.UtcNow.Date.ToString("dd/MM/yyyy")
					</MudText>
					<MudText Typo="Typo.body1">
						Tente novamente mais tarde ou entre em contato com o setor responsável.
					</MudText>
				</MudStack>
			</MudPaper>

		</MudItem>
	</MudGrid>
</MudContainer>