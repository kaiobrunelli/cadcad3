    private async Task VerificarPermissao(Microsoft.AspNetCore.Components.Routing.NavigationContext context)
    {
        // var usuario = await UsuarioService.ConsultaUsuario();
        var usuario = await UsuarioService.ConsultaConfiguracaoUsuario();

        var temAcesso = usuario != null && usuario.Areas.Any();

         if (!temAcesso && !context.Path.Contains("acessonegado") && !context.Path.Contains("chatHub"))
         {
             Navigation.NavigateTo($"{Navigation.BaseUri}acessonegado", true);      
         }

    }

