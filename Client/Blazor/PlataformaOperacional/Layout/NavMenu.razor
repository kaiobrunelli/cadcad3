@* \/  MudNavMenu para ambiente de PUBLICAÇÃO \/ *@
@inject UsuarioService UsuarioService
@inject NavigationManager Navigation 

<MudPaper Width="250px" Class="d-inline-flex" Elevation="0">
	<MudNavMenu Class="mud-width-full">
		<MudNavLink Href="@($"{Navigation.BaseUri}")" Icon="@Icons.Material.Filled.Home">Página Inicial</MudNavLink>
		@* <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home">Página Inicial</MudNavLink> *@
		@if (ConfiguracoesDeUsuario != null)
		{
			 @foreach (var area in ConfiguracoesDeUsuario.Areas)
			{
				<MudNavGroup Title="@area.DeArea" Icon="@area.Icon" Expanded="false">
					@foreach (var aplicativo in area.Aplicativo)
					{
						<MudNavLink Href="@aplicativo.Href" Icon="@aplicativo.iconAplicativo" Class="pr-2">@(aplicativo.DeAplicativo)</MudNavLink>
					}
				</MudNavGroup>			
			}
			@* <MudNavLink Href="@($"{Navigation.BaseUri}EncontroDeContas")" Icon="@Icons.Material.Filled.AddCard" Class="pr-2">ECT Test</MudNavLink> *@

		@* 	<MudNavGroup Title="Cobrança" Icon="@Icons.Material.Filled.CurrencyExchange" Expanded="false">

				<MudNavLink Href="@($"{Navigation.BaseUri}amortizacaocaixa")" Icon="@Icons.Material.Filled.PriceCheck" Class="pr-2">Amortização Caixa</MudNavLink>
				<MudNavLink Href="@($"{Navigation.BaseUri}crfhome")" Icon="@Icons.Material.Outlined.FiberNew" Class="pr-2">CRF Home</MudNavLink>

			</MudNavGroup>
			<MudNavGroup Title="Preditor" Icon="@Icons.Material.Outlined.DataArray" Expanded="false">

				<MudNavLink Href="@($"{Navigation.BaseUri}comparativo")" Icon="@Icons.Material.Outlined.FileOpen" Class="pr-2">Preditor</MudNavLink>

			</MudNavGroup> *@
		}
		else
		{	
			Navigation.NavigateTo($"{Navigation.BaseUri}acessonegado", true);
			Console.WriteLine("Usuário sem aplicativos cadastrados.");
		}

	</MudNavMenu>
</MudPaper>

@code {
	private ConfiguracoesUsuario ConfiguracoesDeUsuario { get; set; } = new();


	protected override async Task OnInitializedAsync()
	{
		ConfiguracoesDeUsuario = await UsuarioService.ConsultaConfiguracaoUsuario();
	}
}




