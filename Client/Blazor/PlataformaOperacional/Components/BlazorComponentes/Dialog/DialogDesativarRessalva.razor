<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            Deseja excluir a ressalva?
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body1">
            Ao confirmar essa ação, a ressalva será apagada definitivamente.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Class="btn-caixa-small" OnClick="Cancel">Cancelar</MudButton>
        <MudButton Variant="Variant.Outlined" Class="btn-caixa-small" Color="Color.Error" OnClick="Submit">Excluir</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private void Submit() => MudDialog.Close(DialogResult.Ok(true));

    private void Cancel() => MudDialog.Cancel();
}
